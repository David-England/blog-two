---
const {title} = Astro.props;
---
<a class="header" href="/">{title}</a>

<style>
    a {
        color: inherit;
        display: block;
        font-family: "Fira Code", "Courier New";
        font-size: large;
        background-color: cyan;
        position: sticky;
        text-decoration: inherit;
        top: 0%;
        width: 100%;
    }

    a:active {
        background-color: black;
        color: cyan;
    }
</style>