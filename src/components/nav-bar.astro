---
import NavButton from "./nav-button.astro";
import { sortTopic } from "../utilities/metadata-util";
import type TopicMetadata from "../types/topic-metadata"

interface Props {
    topics: TopicMetadata[]
}

const {topics} = Astro.props;
---
<div>
    {topics.sort(sortTopic).map(
        t => <NavButton text={t.name} url={t.url} />
    )}
    <NavButton text="About" url="/about" />
</div>

<style>
    div {
        position: sticky;
        margin: 5px 0px 5px 0px;
        top: 18px;
    }
</style>