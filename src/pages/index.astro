---
import BlogLinkTile from "../components/blog-link-tile.astro";
import DefaultLayout from "../layouts/default-layout.astro";
import { readDate_yyyyMMdd } from "../utilities/date-util"
import type BlogMetadata from "../types/blog-metadata"

function convert(obj: any): BlogMetadata {
    return {
        title: obj.frontmatter.title,
        authorName: obj.frontmatter.authorName,
        topic: obj.frontmatter.topic,
        datePublished: readDate_yyyyMMdd(obj.frontmatter.datePublished),
        url: obj.url
    }
}

const blogs: any[] = Object.values(import.meta.glob("./blogs/*.md", {eager: true}));
---

<DefaultLayout title={"Willkommen"} tabName={"neon95"}>
    {(blogs.map(convert).map(
        b => <BlogLinkTile metadata={b} />
    ))}
</DefaultLayout>