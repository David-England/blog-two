---
import "./reset.css";
import Header from "../components/header.astro";
import NavBar from "../components/nav-bar.astro";
import { convertGlobMeta, getTopics } from "../utilities/metadata-util";

const {title, tabName} = Astro.props;
const blogs = Object.values(import.meta.glob("/src/pages/blogs/*.md", {eager: true}))
    .map(convertGlobMeta);
const topics = getTopics(blogs);
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/icon_1.ico" />
		<link href="https://fonts.googleapis.com/css2?family=Fira+Code" rel="stylesheet">
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{tabName}</title>
	</head>
	<body>
		<Header title={"neon95"} />
		<NavBar topics={topics} />
		<h1>{title}</h1>
        <slot />
	</body>
</html>

<style>
	::selection {
    	background-color: hotpink;
	}

	body {
		font-family: "Times New Roman";
		padding: 8px;
	}

	h1 {
		font-family: "Fira Code", "Courier New";
		font-size: 2em;
		font-weight: bold;
		margin: .67em 0 .67em 0;
	}
</style>