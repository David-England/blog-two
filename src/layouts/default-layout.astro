---
import "./reset.css";
const {title} = Astro.props;
---
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/icon_1.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<h1>{title}</h1>
        <slot />
	</body>
</html>

<style>
	::selection {
    	background-color: hotpink;
	}

	h1 {
		font-family: "Fira Code", "Courier New";
		font-size: 2em;
		font-weight: bold;
		margin: .67em 0 .67em 0;
	}

	p {
		margin: 16px 0px 16px 0px;
	}
</style>